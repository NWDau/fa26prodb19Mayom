
extends layout

block content
  h1= title

  form(id='JuiceForm', action="/resource/juices", method="POST")
    div.form-group
      label.juiceAttr(for='flavor') Juice Flavor
      input#flavor(type='text', name='flavor', required=true)

    div.form-group
      label.juiceAttr(for='volume') Juice Volume
      input#volume(type='number', name='volume', required=true)

    div.form-group
      label.juiceAttr(for='sugarContent') Sugar Content
      input#sugarContent(type='number', name='sugarContent', required=true)

    div.form-group
      label.juiceAttr(for='brand') Juice Brand
      input#brand(type='text', name='brand', required=true)

    input(type="submit" value="Save Juice")

  script.
    document.forms['JuiceForm'].addEventListener('submit', (event) => {
      event.preventDefault();

      fetch(event.target.action, {
        method: 'POST',
        body: new URLSearchParams(new FormData(event.target))
      }).then((resp) => {
        if (!resp.ok) {
          throw new Error("Server returned " + resp.status);
        }
        return resp.json();
      }).then((body) => {
        alert("Save succeeded");
      }).catch((error) => {
        alert("Save failed: " + error);
      });
    });
