
extends layout

block content
  h1= title

  if (toShow == null)
    h2 No juice instance found to update
    a.btn.btn-secondary(href='/juices') Back to Juices

  else
    - let juiceid = toShow._id

    h3 Juice ID: #{juiceid}

    form(id='JuiceForm', action=`/resource/juices/${juiceid}`, method="PUT")
      div.form-group
        label.juiceAttr(for='flavor') Juice Flavor
        input#flavor(type='text', name='flavor', value=toShow.flavor, required=true)

      div.form-group
        label.juiceAttr(for='volume') Juice Volume
        input#volume(type='number', name='volume', value=toShow.volume, required=true)

      div.form-group
        label.juiceAttr(for='sugarContent') Sugar Content
        input#sugarContent(type='number', name='sugarContent', value=toShow.sugarContent, required=true)

      div.form-group
        label.juiceAttr(for='brand') Juice Brand
        input#brand(type='text', name='brand', value=toShow.brand, required=true)

      input(type="submit" value="Update Juice")

    script.
      document.forms['JuiceForm'].addEventListener('submit', (event) => {
        event.preventDefault();

        fetch(event.target.action, {
          method: 'PUT',
          body: new URLSearchParams(new FormData(event.target))
        }).then((resp) => {
          if (!resp.ok) {
            throw new Error("Server returned " + resp.status);
          }
          return resp.json();
        }).then((body) => {
          alert("Update succeeded");
        }).catch((error) => {
          alert("Update failed: " + error);
        });
      });