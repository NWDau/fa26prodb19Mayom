
extends layout

block content
  h1.mb-4= title

  if (toShow == null)
    div.alert.alert-warning
      h3 No juice instance found to delete.
    a.btn.btn-secondary(href='/juices') Back to Juices

  else
    - let juiceid = toShow._id
    - let actionid = "/resource/juices/" + juiceid

    div.card.shadow.p-4
      h3.text-danger Confirm Juice Deletion

      p.text-muted Are you sure you want to delete this juice?

      hr

      div.row.mb-2
        div.col-sm-4.fw-bold Juice ID:
        div.col-sm-8 #{juiceid}

      div.row.mb-2
        div.col-sm-4.fw-bold Flavor:
        div.col-sm-8 #{toShow.flavor}

      div.row.mb-2
        div.col-sm-4.fw-bold Volume:
        div.col-sm-8 #{toShow.volume}

      div.row.mb-2
        div.col-sm-4.fw-bold Sugar Content:
        div.col-sm-8 #{toShow.sugarContent}

      div.row.mb-2
        div.col-sm-4.fw-bold Brand:
        div.col-sm-8 #{toShow.brand}

      hr

      button.btn.btn-danger.m-2(
        onclick="deleteOnid()"
      ) Delete Juice

      button.btn.btn-secondary.m-2(
        onclick="cancel()"
      ) Cancel

    script.
      const actionid = !{JSON.stringify(actionid)};

      function cancel() {
        window.location.href = '/juices';
      }

      function deleteOnid() {
        console.log("Starting delete");

        fetch(actionid, {
          method: 'DELETE'
        })
        .then((resp) => {
          if (!resp.ok) {
            throw new Error("Server returned " + resp.status);
          }
          return resp.json();
        })
        .then((body) => {
          alert("Delete succeeded");
          window.location.href = '/juices';
        })
        .catch((error) => {
          alert("Delete failed: " + error);
        });
      }
