extends layout

block content
  h1= title

  div(class="container-fluid")
    a(class="btn btn-success mb-3", href="/juices/create") Add New Juice

    div(class="row")
      each item, index in results
        div(class="col-sm-3")
          div(class="card p-3 m-2")
            h3= item.flavor
            p Brand: #{item.brand}

            div(class="d-flex gap-2")
              a(class="btn btn-info btn-sm", href=`/juices/${item._id}`) Inspect
              a(class="btn btn-warning btn-sm", href=`/juices/${item._id}/update`) Update
              a(class="btn btn-danger btn-sm", href=`/juices/${item._id}/delete`) Delete