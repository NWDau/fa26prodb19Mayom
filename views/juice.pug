extends layout

block content
  h1= title
  

  -
    let results = [
      { flavor: "Orange", volume: 500, sugarContent: 22, brand: "Tropicana" },
      { flavor: "Apple", volume: 350, sugarContent: 18, brand: "Mott's" },
      { flavor: "Grape", volume: 1000, sugarContent: 36, brand: "Welch's" }
    ]

  div(class="container-fluid")
    div(class="row")
      each item, index in results
        div(class="col-sm-2", onclick=`buy(${index})`)
          p Flavor: #{item.flavor}
          p Volume: #{item.volume}
          p Sugar Content: #{item.sugarContent} 
          p Brand: #{item.brand}

  script. 
    function buy(index){
      alert("You purchased item " + index);
    }